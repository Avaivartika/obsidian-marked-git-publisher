{
  "name": "obsidian-marked-git-publisher",
  "version": "0.1.3",
  "description": "Mark Obsidian notes and folders for selective public GitHub publishing",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "publishing",
    "git",
    "github-pages"
  ],
  "author": "Avaivartika; based on Ivan Grubišić",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/picomatch": "^4.0.2",
    "esbuild": "^0.27.2",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^17.0.0",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "picomatch": "^4.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
